# CognoDB Cloud Bolt credentials — replace all placeholders locally.
COGNODB_URI=bolt+s://your-instance.cognodb.cloud:7687
COGNODB_USERNAME=neo4j
COGNODB_PASSWORD=replace-with-your-password
# Comma-separated additional deployment origins (the standard local and Vercel origins are built in).
CORS_ORIGINS=https://supplyshield-web-git-main-venkatesh721s-projects.vercel.app
